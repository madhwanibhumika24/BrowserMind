# LLM provider key (Google AI Studio - https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (MySQL) - create an empty database first, e.g.:
#   CREATE DATABASE browsermind;
# Tables are created automatically on backend startup.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/browsermind

# Auth (Google Sign-In)
# Must be the SAME client ID as frontend/manifest.json -> oauth2.client_id
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com

# App
APP_ENV=development
ALLOWED_ORIGINS=chrome-extension://*
