{
  "manifest_version": 3,
  "name": "BrowserMind",
  "version": "0.1.0",
  "description": "A context-aware AI assistant for your browser — understands your open tabs, routes to specialized agents, and remembers with your permission.",
  "action": {
    "default_title": "Open BrowserMind"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js", "src/content/selection-toolbar.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://localhost:8000/*"],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/sidebar/sidebar.html", "src/sidebar/sidebar.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
