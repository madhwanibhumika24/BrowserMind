{
  "manifest_version": 3,
  "name": "BrowserMind",
  "version": "0.1.0",
  "description": "A context-aware AI assistant for your browser — understands your open tabs, routes to specialized agents, and remembers with your permission.",
  "action": {
    "default_title": "Open BrowserMind"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": ["tabs", "storage", "scripting", "activeTab", "identity"],
  "host_permissions": ["http://localhost:8000/*"],
  "commands": {
    "quick-ask": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open BrowserMind and focus the chat input"
    }
  },
  "oauth2": {
    "client_id": "970498042444-qut77a8et047enq93c4hhljskhhh260b.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/forms.body",
      "https://www.googleapis.com/auth/forms.responses.readonly",
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/sidebar/sidebar.html", "src/sidebar/sidebar.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
